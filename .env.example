# Configurações do Banco de Dados PostgreSQL — oficial_db
# Local: sga_db_local (porta exposta no host). Deploy Docker na VPS (stack.yml):
# container do oficial_db pela rede oficial_db_net.
# DB_SCHEMA: search_path; as tabelas próprias ficam em `dashboard` (o mesmo
# schema do django_migrations) e as demais são lidas por nome qualificado.
DB_NAME=oficial_db
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_HOST=ip_ou_host_do_banco
DB_PORT=5432
DB_SCHEMA=dashboard
SECRET_KEY=sua_chave_secreta_aqui

# Django (Streamlit é o servidor real em produção — Django só é usado via ORM;
# ver `django_setup.py`/Dockerfile) — mesmo padrão do resto do ecossistema:
# default seguro, nunca ligar DEBUG em produção.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
